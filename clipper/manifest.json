{
  "manifest_version": 3,
  "name": "WayNoted Web Clipper",
  "version": "1.0.0",
  "description": "Save pages to your local WayNoted workspace.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Recortar para o WayNoted",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  }
}
