{
  "name": "workspace-desktop",
  "productName": "WayNoted",
  "version": "1.0.0",
  "description": "WayNoted — local workspace for macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:agent && concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on tcp:5310 && WORKSPACE_DEV=1 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "build:native": "node build/build-native.mjs",
    "build:agent": "node build/build-agent-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && npm run build:agent && electron .",
    "dist": "npm run configure && npm run build && npm run build:native && npm run build:agent && node build/package.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:raw": "node --experimental-strip-types --test tests/*.test.*",
    "mcp": "node electron/mcp-server.cjs",
    "cli": "node electron/cli.cjs",
    "dist:test": "npm run configure && npm run build && npm run build:native && npm run build:agent && node build/package.mjs --test",
    "configure": "node build/configure-product.mjs",
    "predev": "npm run configure",
    "prebuild": "npm run configure",
    "pretest": "npm run configure"
  },
  "keywords": [],
  "author": "",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mantine/core": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@tiptap/core": "^3.31.4",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjpraia/WayNoted.git"
  }
}
